<UserControl x:Class="MalirTonight.UI.Views.LicensingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Licensing" FontSize="28" FontWeight="Bold" Margin="0 0 0 24" />

        <materialDesign:Card Grid.Row="1" Padding="24" UniformCornerRadius="8" Margin="0 0 0 24">
            <StackPanel>
                <TextBlock Text="Current License" FontSize="16" FontWeight="Medium" />
                <TextBlock Text="{Binding CurrentTier, StringFormat='Tier: {0}'}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0 12 0 0" />

                <StackPanel Orientation="Horizontal" Margin="0 24 0 0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding ActivateBasicCommand}"
                            Content="Activate Basic"
                            Margin="0 0 12 0" />
                    <Button Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            Command="{Binding ActivatePremiumCommand}"
                            Content="Activate Premium" />
                </StackPanel>

                <TextBlock Text="Premium features: Auto Payroll, Expenses, Audit Logs, Analytics, Multi-User"
                           FontSize="11" Opacity="0.6" Margin="0 16 0 0" TextWrapping="Wrap" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
