<Window x:Class="MalirTonight.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:MalirTonight.UI.ViewModels"
        xmlns:views="clr-namespace:MalirTonight.UI.Views"
        mc:Ignorable="d"
        Title="Malir Tonight" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignBackground}"
        materialDesign:ColorZoneAssist.Mode="Standard">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeListViewModel}">
            <views:EmployeeListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeeFormViewModel}">
            <views:EmployeeFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceListViewModel}">
            <views:AttendanceListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaveListViewModel}">
            <views:LeaveListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentListViewModel}">
            <views:DepartmentListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpenseListViewModel}">
            <views:ExpenseListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicensingViewModel}">
            <views:LicensingView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource SidebarBorder}" Padding="24,24,24,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Restaurant" Width="32" Height="32"
                                                     Foreground="{StaticResource SidebarAccent}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Malir Tonight" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource SidebarText}" />
                                <TextBlock Text="Restaurant Management" FontSize="11"
                                           Foreground="{StaticResource SidebarTextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="Toggle Theme"
                                    Padding="4"
                                    Foreground="{StaticResource SidebarTextMuted}">
                                <materialDesign:PackIcon Kind="ThemeLightDark" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel x:Name="SidebarMenu">
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToDashboardCommand}"
                                Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" />
                                <TextBlock Text="Dashboard" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToEmployeesCommand}"
                                Tag="Employees">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" />
                                <TextBlock Text="Employees" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToAttendanceCommand}"
                                Tag="Attendance">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarCheck" Width="22" Height="22" />
                                <TextBlock Text="Attendance" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToSalariesCommand}"
                                Tag="Salaries">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" />
                                <TextBlock Text="Salaries" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToLeavesCommand}"
                                Tag="Leaves">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Beach" Width="22" Height="22" />
                                <TextBlock Text="Leaves" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToDepartmentsCommand}"
                                Tag="Departments">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Domain" Width="22" Height="22" />
                                <TextBlock Text="Departments" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToExpensesCommand}"
                                Tag="Expenses">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="22" Height="22" />
                                <TextBlock Text="Expenses" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToReportsCommand}"
                                Tag="Reports">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileReport" Width="22" Height="22" />
                                <TextBlock Text="Reports" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToSettingsCommand}"
                                Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" />
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToAuditLogsCommand}"
                                Tag="AuditLogs">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="22" Height="22" />
                                <TextBlock Text="Audit Logs" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToLicensingCommand}"
                                Tag="Licensing">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Key" Width="22" Height="22" />
                                <TextBlock Text="Licensing" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SidebarBorder}" Padding="16,16,16,20">
                    <StackPanel>
                        <Border Background="{StaticResource SidebarItemHover}" CornerRadius="8" Padding="12">
                            <StackPanel>
<TextBlock Text="LICENSE" FontSize="10" FontWeight="SemiBold"
           Foreground="{StaticResource SidebarTextMuted}" />
                                <TextBlock Text="{Binding CurrentLicenseTier, FallbackValue='Basic'}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource SidebarAccent}" Margin="0,4,0,0" />
                                <TextBlock Text="Malir Tonight v1.0" FontSize="10"
                                           Foreground="{StaticResource SidebarTextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource MaterialDesignBackground}">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>