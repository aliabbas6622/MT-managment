<UserControl x:Class="MalirTonight.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,32" Style="{StaticResource SectionTitle}" />

            <!-- Row 1: Main Stats -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Style="{StaticResource StatCardIcon}"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="Employees" FontSize="13" Opacity="0.6"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalEmployees}" Style="{StaticResource StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="Total Staff" Style="{StaticResource StatLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Style="{StaticResource StatCardIcon}"
                                                     Foreground="#4CAF50" />
                            <TextBlock Text="Present Today" FontSize="13" Opacity="0.6"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PresentToday}" Style="{StaticResource StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="Checked In" Style="{StaticResource StatLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarClock" Style="{StaticResource StatCardIcon}"
                                                     Foreground="#FF9800" />
                            <TextBlock Text="Pending Leaves" FontSize="13" Opacity="0.6"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingLeaves}" Style="{StaticResource StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="Awaiting Review" Style="{StaticResource StatLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Style="{StaticResource StatCardIcon}"
                                                     Foreground="#2196F3" />
                            <TextBlock Text="Unpaid Salaries" FontSize="13" Opacity="0.6"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnpaidSalaries, StringFormat='{}{0:C}'}" Style="{StaticResource StatNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="Outstanding" Style="{StaticResource StatLabel}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 2: Departments & Expenses -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Departments" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Width="28" Height="28"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="{Binding TotalDepartments}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Active Departments" Style="{StaticResource StatLabel}" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Monthly Expenses" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="28" Height="28"
                                                     Foreground="#F44336" />
                            <TextBlock Text="{Binding MonthlyExpenses, StringFormat='{}{0:C}'}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="This Month" Style="{StaticResource StatLabel}" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Row 3: Quick Actions -->
            <materialDesign:Card Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding NavigateToAddEmployeeCommand}"
                                Content="+ Add Employee"
                                Margin="0,0,12,0"
                                Padding="20,10" FontSize="14" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding NavigateToEmployeesCommand}"
                                Content="View All Employees"
                                Margin="0,0,12,0"
                                Padding="20,10" FontSize="14" />
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding NavigateToLeavesCommand}"
                                Content="Review Leaves"
                                Padding="20,10" FontSize="14" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>