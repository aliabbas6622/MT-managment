<UserControl x:Class="MalirTonight.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,32" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="24" UniformCornerRadius="12"
                                     Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="Employees" FontSize="14" Opacity="0.7"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalEmployees}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,16,0,0" />
                        <TextBlock Text="Total Staff" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Padding="24" UniformCornerRadius="12"
                                     Margin="12,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="24" Height="24"
                                                     Foreground="#4CAF50" />
                            <TextBlock Text="Present Today" FontSize="14" Opacity="0.7"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PresentToday}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,16,0,0" />
                        <TextBlock Text="Checked In" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="24" UniformCornerRadius="12"
                                     Margin="12,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24"
                                                     Foreground="#FF9800" />
                            <TextBlock Text="Pending Leaves" FontSize="14" Opacity="0.7"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingLeaves}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,16,0,0" />
                        <TextBlock Text="Awaiting Review" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="3" Padding="24" UniformCornerRadius="12"
                                     Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="24" Height="24"
                                                     Foreground="#2196F3" />
                            <TextBlock Text="Unpaid Salaries" FontSize="14" Opacity="0.7"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnpaidSalaries, StringFormat='{}{0:C}'}" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,16,0,0" />
                        <TextBlock Text="Outstanding" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="24" UniformCornerRadius="12"
                                     Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Departments" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Width="24" Height="24"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="{Binding TotalDepartments}" FontSize="32" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Active Departments" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1" Padding="24" UniformCornerRadius="12"
                                     Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Monthly Expenses" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="24" Height="24"
                                                     Foreground="#F44336" />
                            <TextBlock Text="{Binding MonthlyExpenses, StringFormat='{}{0:C}'}" FontSize="32" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="This Month" FontSize="12" Opacity="0.5"
                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,8,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <materialDesign:Card Padding="24" UniformCornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding NavigateToAddEmployeeCommand}"
                                Content="+ Add Employee"
                                Margin="0,0,12,0"
                                Padding="16,8" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding NavigateToEmployeesCommand}"
                                Content="View All Employees"
                                Margin="0,0,12,0"
                                Padding="16,8" />
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding NavigateToLeavesCommand}"
                                Content="Review Leaves"
                                Padding="16,8" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>