generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  employeeCount Int      @default(0)

  @@map("departments")
}

model Employee {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String   @unique
  phone      String   @default("")
  position   String
  department String
  hireDate   String
  salary     Float
  status     String   @default("active")
  avatar     String?

  attendances Attendance[]
  leaves      Leave[]

  @@map("employees")
}

model Attendance {
  id           Int    @id @default(autoincrement())
  employeeId   Int
  employeeName String
  date         String
  checkIn      String @default("")
  checkOut     String @default("")
  status       String @default("present")
  notes        String @default("")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model Leave {
  id           Int    @id @default(autoincrement())
  employeeId   Int
  employeeName String
  startDate    String
  endDate      String
  type         String @default("sick")
  status       String @default("pending")
  reason       String @default("")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model Expense {
  id          Int    @id @default(autoincrement())
  category    String
  amount      Float
  description String @default("")
  date        String

  @@map("expenses")
}

model AuditLog {
  id        Int    @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int    @default(0)
  details   String @default("")
  timestamp String
  user      String @default("System")

  @@map("audit_logs")
}

model AppUser {
  id           String   @id
  name         String
  email        String   @unique
  username     String?
  role         String   @default("viewer")
  passwordHash String
  createdAt    String

  @@map("app_users")
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("app_settings")
}
