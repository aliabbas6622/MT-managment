generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  SICK
  PERSONAL
  VACATION
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum SalaryStatus {
  PENDING
  PROCESSED
  PAID
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum LicenseType {
  BASIC
  PREMIUM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

model Employee {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  position     String
  departmentId String?
  hireDate     DateTime
  salary       Float
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  department   Department?    @relation(fields: [departmentId], references: [id])
  attendances  Attendance[]
  salaries     Salary[]
  leaves       Leave[]

  @@index([departmentId])
  @@index([status])
  @@index([email])
  @@map("employees")
}

model Attendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())

  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

model Salary {
  id         String       @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  gross      Float
  taxRate    Float        @default(0)
  taxAmount  Float        @default(0)
  net        Float
  status     SalaryStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  employee   Employee     @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([year, month])
  @@map("salaries")
}

model Leave {
  id         String       @id @default(uuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  type       LeaveType
  status     LeaveStatus  @default(PENDING)
  reason     String?
  approvedBy String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  employee   Employee     @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  description String?
  date        DateTime
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@map("expenses")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  type        String
  data        Json
  generatedBy String?
  createdAt   DateTime @default(now())

  @@map("reports")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(STAFF)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]

  @@map("users")
}

model License {
  id          String        @id @default(uuid())
  token       String        @unique
  type        LicenseType   @default(BASIC)
  status      LicenseStatus @default(ACTIVE)
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@map("licenses")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SyncQueue {
  id         String     @id @default(uuid())
  entityType String
  entityId   String
  action     SyncAction
  payload    Json
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  syncedAt   DateTime?

  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_queue")
}
